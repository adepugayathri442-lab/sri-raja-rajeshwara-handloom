# ========================================================================
# SRI RAJA RAJESHWARA HANDLOOM - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env.local and populate with your production credentials.
# ========================================================================

# Application URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------
# Obtain these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------
# WhatsApp Business Configuration
# ------------------------------------------------------------------------
# E.164 formatted number without + (e.g., 919876543210)
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_WHATSAPP_DEFAULT_MESSAGE=Hello Sri Raja Rajeshwara Handloom, I am interested in wholesale textile supply for my business.

# ------------------------------------------------------------------------
# Business Information (Overrides default placeholders)
# ------------------------------------------------------------------------
NEXT_PUBLIC_BUSINESS_PHONE=
NEXT_PUBLIC_BUSINESS_EMAIL=
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_BUSINESS_CITY=
NEXT_PUBLIC_BUSINESS_STATE=
NEXT_PUBLIC_BUSINESS_PINCODE=
NEXT_PUBLIC_GST_NUMBER=

# ------------------------------------------------------------------------
# Payment Gateway (Future Phase)
# ------------------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ------------------------------------------------------------------------
# n8n WhatsApp Automation Webhook (Server-Side Only)
# ------------------------------------------------------------------------
# Configure your n8n webhook URL to receive order and customer notification events.
# If left blank, the website functions normally and events log safely in development.
N8N_WHATSAPP_WEBHOOK_URL=
N8N_WHATSAPP_WEBHOOK_SECRET=

